{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        "ai": {
          "$id": {
            ".validate": "data.exists() ? newData.child('from').val() === data.child('from').val() : newData.child('from').val() === auth.uid"
          }
        }
      }
    }
  }
}
